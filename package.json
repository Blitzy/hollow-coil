{
  "name": "mandreljs-root",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandreljs/mandrel.js.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "dev": "mandreljs dev",
    "build": "mandreljs build",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/sim/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node tools/src/test-package.ts",
    "check": "npm run check-files && npm run validate && npm run typecheck && npm test && npm run compile -- --mode check && npm run test:package",
    "check-files": "node tools/src/check-files.ts",
    "validate": "mandreljs validate",
    "bspdump": "mandreljs bspdump",
    "compile": "mandreljs compile",
    "setup": "mandreljs setup",
    "install-trenchbroom": "mandreljs install-trenchbroom",
    "make-placeholder-textures": "node tools/src/make-placeholder-textures.ts",
    "rebaseline-demos": "node tools/src/rebaseline-demos.ts",
    "package": "node tools/src/package.ts",
    "release": "node tools/src/release.ts",
    "changelog": "node tools/src/changelog.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
