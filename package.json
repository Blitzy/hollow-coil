{
  "name": "mandreljs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "dev": "mandrel dev",
    "build": "mandrel build",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/sim/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-files": "node tools/src/check-files.ts",
    "validate": "mandrel validate",
    "bspdump": "mandrel bspdump",
    "compile": "mandrel compile",
    "setup": "mandrel setup",
    "install-trenchbroom": "mandrel install-trenchbroom",
    "make-placeholder-textures": "node tools/src/make-placeholder-textures.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
