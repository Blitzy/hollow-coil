{
  "name": "mandreljs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w @mandreljs/game --",
    "build": "npm run typecheck && npm run build -w @mandreljs/game",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/sim/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-files": "node tools/src/check-files.ts",
    "validate": "node tools/src/validate.ts",
    "bspdump": "node tools/src/bspdump.ts",
    "compile": "node tools/src/compile.ts",
    "setup": "node tools/src/setup.ts",
    "install-trenchbroom": "node tools/src/install-trenchbroom.ts",
    "make-placeholder-textures": "node tools/src/make-placeholder-textures.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
