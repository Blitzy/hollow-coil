{
  "name": "hollow-coil",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hollow-coil/game --",
    "build": "npm run typecheck && npm run build -w @hollow-coil/game",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/sim/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "python tools/validate.py",
    "compile": "python tools/compile.py",
    "setup": "python tools/setup.py"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
