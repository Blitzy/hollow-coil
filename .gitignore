### Mandrel.js
# Compiled maps (tools/compile writes here, one folder per game)
/build/

# Pinned third-party tools installed by tools/src/setup.ts (npm run setup)
/.tools/

# ericw-tools side output, in case a compile runs outside /build
*.bsp
*.prt
*.pts
*.lin
*.lit
*.lux
*.lit2
*.texinfo.json
*.content.json
# ...except test fixtures, which are compiled once and committed
!/packages/*/tests/fixtures/**/*.bsp

# TrenchBroom autosaves
autosave/

# TrenchBroom per-user settings, written through the install link
/example/trenchbroom/GameEngineProfiles.cfg
/example/trenchbroom/CompilationProfiles.cfg
# The engine's trenchbroom/ folder, linked in by npm run install-trenchbroom for the FGD's @include
/example/trenchbroom/engine

# Playwright
test-results/
playwright-report/
blob-report/

# Claude Code local settings (shared settings.json is kept)
.claude/settings.local.json

### Node
node_modules/
dist/
coverage/
*.tsbuildinfo
*.tgz
.npm
*.log

# dotenv
.env
.env.local
.env.*.local

### OS
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*~

### VS Code
# settings.json stays local: it tends to hold machine-specific paths
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
