### Mandrel.js
# Compiled maps and releases: each game compiles into its own build/ (npm run compile)
# and builds releases into its own dist/ (npm run build)
/example/build/
/example/dist/

# Where compiled maps and pinned tools went before they moved to example/build/ and the
# per-user tools cache; safe to delete
/build/
/.tools/

# ericw-tools side output, in case a compile runs outside a build/ folder
*.bsp
*.prt
*.pts
*.lin
*.lit
*.lux
*.lit2
*.texinfo.json
*.content.json
# ...except test fixtures, which are compiled once and committed
!/packages/*/tests/fixtures/**/*.bsp

# TrenchBroom autosaves
autosave/

# TrenchBroom per-user settings, written through the install link
/example/trenchbroom/GameEngineProfiles.cfg
/example/trenchbroom/CompilationProfiles.cfg
# The engine's FGD folder (packages/defs/trenchbroom), linked in by npm run install-trenchbroom for the FGD's @include
/example/trenchbroom/mandrel

# Playwright
test-results/
playwright-report/
blob-report/

# Claude Code local settings (shared settings.json is kept)
.claude/settings.local.json

### Node
node_modules/
dist/
coverage/
*.tsbuildinfo
*.tgz
.npm
*.log

# dotenv
.env
.env.local
.env.*.local

### OS
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*~

### VS Code
# settings.json stays local: it tends to hold machine-specific paths
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
