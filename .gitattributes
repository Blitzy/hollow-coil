# Normalize text to LF everywhere. Maps, data, specs, and demos are hashed and
# diffed, so they must be byte-identical across Windows, Linux CI, and macOS.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.wad  binary
*.wal  binary
*.bsp  binary
*.lmp  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.glb  binary
*.blend binary
